{
  "name": "innovation-sandbox-on-aws-approver",
  "version": "0.1.0",
  "description": "Score-based lease approval system for Innovation Sandbox on AWS",
  "type": "module",
  "main": "dist/handler.js",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outdir=dist --format=cjs '--external:@aws-sdk/*'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test cdk --ext .ts",
    "lint:fix": "eslint src test cdk --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"cdk/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"cdk/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "cdk:synth": "npm run build && cdk synth",
    "cdk:diff": "npm run build && cdk diff",
    "cdk:deploy": "npm run build && cdk deploy --require-approval never"
  },
  "keywords": [
    "aws",
    "lambda",
    "approval",
    "scoring",
    "innovation-sandbox"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/idempotency": "^2.33.0",
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/metrics": "^2.33.0",
    "@aws-lambda-powertools/parameters": "^2.33.0",
    "@aws-sdk/client-appconfigdata": "^3.1049.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1049.0",
    "@aws-sdk/client-dynamodb": "^3.1049.0",
    "@aws-sdk/client-eventbridge": "^3.1049.0",
    "@aws-sdk/client-identitystore": "^3.1049.0",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/client-sns": "^3.1049.0",
    "@aws-sdk/client-sqs": "^3.1049.0",
    "@aws-sdk/client-sts": "^3.1049.0",
    "@aws-sdk/lib-dynamodb": "^3.1049.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "@co-cddo/isb-client": "https://github.com/co-cddo/innovation-sandbox-on-aws-client/releases/download/v2.0.3/co-cddo-isb-client-2.0.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.6",
    "aws-cdk": "^2.1122.0",
    "aws-cdk-lib": "^2.254.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
